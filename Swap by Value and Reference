#include <stdio.h>
void swap(int *a,int *b)
{
    int t=*a;
    *a=*b;
    *b=t;
    printf("Inside Function: a= %d  b=%d\n",*a,*b);
}
int main() {
    int a=10,b=20;
    printf("Call By Reference\n");
    printf("a= %d  b=%d\n",a,b);
    swap(&a,&b);
     printf("a= %d  b=%d\n",a,b);

    return 0;
}
