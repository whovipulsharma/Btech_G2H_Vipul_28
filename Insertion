
#include <stdio.h>
void sort(int a[])
{
    for(int i=1;i<5;i++)
    {
        int j=i-1;
        int k=a[i];
        while((j>=0)&&(a[j]>k))
        {
            a[j+1]=a[j];
            j--;
        }
        a[j+1]=k;
    }
}
int main() {
int a[]={7,8,3,9,2};
sort(a);
   for(int j=0;j<5;j++)
       {
           printf("%d ",a[j]);
       }
    return 0;
}
